{
	"name": "diff-delver",
	"version": "0.0.1",
	"description": "LLM-assisted diff organisation. An agent sorts your diff into logical sections and annotates it; you do the reviewing.",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"bin": {
		"diff-delver": "bin/diff-delver.js"
	},
	"files": [
		"bin",
		"build",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.4.2",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#build/handler.js": {
			"types": "./src/build-handler.d.ts",
			"default": "./build/handler.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build --config vite.cli.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && vite build && vite build --config vite.cli.config.ts",
		"verify": "node scripts/verify.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:core": "vitest run --project core",
		"test:integration": "vitest run --project integration",
		"test:watch": "vitest",
		"test:journeys": "pnpm build && playwright test",
		"journeys:update": "node scripts/journeys.ts update",
		"journeys:repeat": "node scripts/journeys.ts repeat",
		"fixtures:capture": "node scripts/capture-diff-fixtures.ts",
		"fixtures:old-database": "node scripts/capture-old-database.ts",
		"bd": "node scripts/bd.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@fontsource/inter": "5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26",
		"@types/pngjs": "^6.0.5",
		"@typescript-eslint/utils": "^8.73.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fast-check": "^4.10.3",
		"globals": "^17.14.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"shiki": "4.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"zod": "^4.6.7"
	}
}
